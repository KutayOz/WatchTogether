# Secrets. Nothing at the repo root reads a .env any more — the Worker's local
# config lives in worker/.dev.vars (ignored there) and the frontend has no
# build-time variables at all — but the patterns stay so a stray one written by
# habit cannot be committed.
.env
.env.local
.env.production

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Node modules (frontend and worker each have their own gitignore too)
node_modules/
