# WatchTogether Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# ===========================================
# REQUIRED - Application will not start without these
# ===========================================

# MongoDB Root Password (used for local Docker MongoDB)
# Generate a strong password: openssl rand -base64 32
MONGO_ROOT_PASSWORD=replace_with_strong_password

# JWT Secret Key (minimum 32 characters)
# Generate one: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_at_least_32_characters

# ===========================================
# OPTIONAL - Have sensible defaults
# ===========================================

# MongoDB Configuration
# For local Docker: leave MONGODB_CONNECTION_STRING empty, it will use MONGO_ROOT_PASSWORD
# For MongoDB Atlas: set the full connection string here
# MONGODB_CONNECTION_STRING=mongodb+srv://user:password@cluster.mongodb.net/watchtogether
MONGO_ROOT_USERNAME=admin

# Frontend URL (used for CORS and email links)
FRONTEND_URL=http://localhost:3000

# API URLs (for frontend build)
API_URL=http://localhost:5001
SIGNALR_URL=http://localhost:5001/hubs/watchtogether

# ===========================================
# EMAIL - Optional (verification emails won't send without this)
# ===========================================

# Resend API Key (https://resend.com)
RESEND_API_KEY=
EMAIL_FROM=noreply@yourdomain.com

# ===========================================
# WEBRTC - Optional (for NAT traversal)
# ===========================================

# TURN Server Configuration — required for connections behind symmetric NAT /
# strict firewalls.
#
# Preferred path: Cloudflare Realtime TURN. When the key id + API token are set,
# the backend mints short-lived ICE credentials per request via the Cloudflare
# API. CLOUDFLARE_TURN_TTL_SECONDS is optional (default 86400 = 24h).
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=
CLOUDFLARE_TURN_TTL_SECONDS=
#
# Fallback path: static coturn credentials (used only when the Cloudflare keys
# above are empty). Include the port in the URL — it is respected
# (e.g. turn:turn.example.com:3478). TURN_TLS_PORT is the separate port for
# TURN-over-TLS (turns:), default 5349.
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
TURN_TLS_PORT=
#
# NOTE: on a platform without docker-compose (Fly / Railway) set these directly
# as the .NET config keys, e.g. WebRTC__CloudflareTurnKeyId,
# WebRTC__CloudflareTurnApiToken, WebRTC__TurnUrl, WebRTC__TurnUsername, …
