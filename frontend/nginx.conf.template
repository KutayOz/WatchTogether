server {
    listen ${PORT};
    server_name localhost;
    root /usr/share/nginx/html;
    index index.html;

    # Security headers — applied to every response
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(self), microphone=(self), display-capture=(self)" always;

    # Content-Security-Policy. A few notes on what's NOT here and why:
    #
    # - script-src does NOT include 'unsafe-inline'. This is the important one.
    #   Inline <script> blocks and event-handler attributes (onclick="...") are
    #   the XSS payload vector — blocking them at the CSP layer is the second
    #   line of defense behind React's auto-escaping.
    #
    # - style-src INCLUDES 'unsafe-inline'. Yes, this is an "audit finding" in
    #   the strict sense, but it's an accepted trade-off here:
    #
    #     The manga aesthetic relies on dynamic inline style={{...}} props all
    #     over the React tree — every TagSticker rotation, every component
    #     animation, every per-instance color override. React's inline-style
    #     prop compiles to JS setting .style on the DOM element, which CSP
    #     treats as "inline". The only ways to drop 'unsafe-inline' for styles
    #     are: (a) move every dynamic value to a className + global stylesheet
    #     — kills the visual identity; or (b) precompute hashes of every
    #     possible style string — impossible for dynamic values.
    #
    #     The real risk style-src 'unsafe-inline' guards against is CSS-based
    #     data exfiltration (attribute selectors that leak via background-image
    #     URL probes). That requires an attacker to inject CSS in the first
    #     place — which our XSS-safe React render path doesn't permit.
    #
    # - frame-ancestors 'none' (clickjacking) + base-uri 'self' (base-tag
    #   hijack) + form-action 'self' (form-redirect) all locked down.
    # Google Sign-In adds three new origins to the policy:
    #   script-src  https://accounts.google.com — the GIS client library
    #   connect-src https://accounts.google.com — token endpoint XHRs
    #   frame-src   https://accounts.google.com — the OAuth popup/iframe
    # img-src also extended to *.googleusercontent.com so the Google
    # user-avatar thumbnails (referenced by GIS One Tap) load. No 'unsafe-
    # eval', no third-party script except this one. Conscious trade:
    # enabling Google sign-in requires trusting accounts.google.com to
    # deliver the same gsi/client bundle every user gets across the web.
    # Watch Together feature adds YouTube embed support:
    #   script-src https://www.youtube.com — YouTube IFrame API
    #   frame-src  https://www.youtube.com https://www.youtube-nocookie.com
    #              — actual <iframe> player. Prefer youtube-nocookie when
    #              possible (privacy-extended mode, fewer third-party
    #              tracking cookies set on first view).
    #   img-src    https://i.ytimg.com — thumbnail previews
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' https://accounts.google.com https://www.youtube.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://accounts.google.com; img-src 'self' data: blob: https://*.googleusercontent.com https://i.ytimg.com; media-src 'self' blob:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://${BACKEND_HOST} wss://${BACKEND_HOST} https://accounts.google.com; frame-src https://accounts.google.com https://www.youtube.com https://www.youtube-nocookie.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;

    # Gzip compression
    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript;

    # Handle React Router - serve index.html for all routes
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Cache static assets
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }
}
